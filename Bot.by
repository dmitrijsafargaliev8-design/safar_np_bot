import logging
import requests
from telegram import Update
from telegram.ext import ApplicationBuilder, ContextTypes, CommandHandler, MessageHandler, filters

# Настройка логирования
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO
)

# Константы
API_KEY_NP = 'ВАШ_API_КЛЮЧ_НОВОЙ_ПОЧТЫ' # Вставьте ваш API-ключ сюда
URL_NP = 'https://api.novaposhta.ua/v2.0/json/'

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Отправляет приветственное сообщение при команде /start."""
    await update.message.reply_text("Привет! Отправь данные заказа в формате:\n\nФИО: Иван Иванов\nТелефон: 380931234567\nГород: Киев\nОтделение: 5")

async def create_np_doctrine(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обрабатывает текстовое сообщение с данными заказа и создает накладную."""
    text = update.message.text
    
    # Парсинг данных из сообщения
    data = {}
    for line in text.split('\n'):
        if ':' in line:
            key, value = line.split(':', 1)
            data[key.strip().lower()] = value.strip()
            
    if 'фио' not in data or 'телефон' not in data or 'город' not in data or 'отделение' not in data:
        await update.message.reply_text("Ошибка: Неверный формат данных. Пожалуйста, используйте формат:\nФИО: ...\nТелефон: ...\nГород: ...\nОтделение: ...")
        return

    # Логика для запроса к API Новой Почты
    payload = {
        "apiKey": API_KEY_NP,
        "modelName": "InternetDocument",
        "calledMethod": "save",
        "methodProperties": {
            "PayerType": "Sender",
            "PaymentMethod": "Cash",
            "DateTime": "06.10.2026", # Текущая дата
            "CargoType": "Cargo",
            "Weight": "1",
            "ServiceType": "WarehouseWarehouse",
            "Description": "Архитектурный oversize худи (SH-HW-01)",
            "Cost": "200",
            "CitySender": "8d5a9ff7-6f77-11e0-8451-001d6074121a", # ID Киева (пример)
            "Sender": "d38dcaaa-6f77-11e0-8451-001d60741218", # ID Отправителя (пример)
            "SenderAddress": "d38dcaaa-6f77-11e0-8451-001d60741218", # ID Адреса отправителя (пример)
            "ContactSender": "d38dcaaa-6f77-11e0-8451-001d60741218", # ID Контакта отправителя (пример)
            "CityRecipient": data['город'], # ID Получателя нужно получить через поиск
            "RecipientAddress": data['отделение'], # ID Отделения получателя
            "RecipientNameLastName": data['фио'].split()[0], # Фамилия
            "RecipientNameFirstName": data['фио'].split()[1] if len(data['фио'].split()) > 1 else "", # Имя
            "RecipientPhone": data['телефон']
        }
    }

    try:
        response = requests.post(URL_NP, json=payload)
        response_data = response.json()
        
        if response_data['success']:
            ttn = response_data['data'][0]['IntDocNumber']
            await update.message.reply_text(f"Заказ успешно оформлен!\nТТН: {ttn}")
        else:
            errors = ", ".join(response_data['errors'])
            await update.message.reply_text(f"Ошибка оформления заказа: {errors}")
            
    except Exception as e:
        await update.message.reply_text(f"Произошла ошибка при отправке запроса: {e}")

if __name__ == '__main__':
    application = ApplicationBuilder().token("ВАШ_ТОКЕН_БОТА").build()
    
    application.add_handler(CommandHandler("start", start))
    application.add_handler(MessageHandler(filters.TEXT & (~filters.COMMAND), create_np_doctrine))
    
    application.run_polling()

